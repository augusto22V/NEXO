# =========================
# HTTP (misma PC que otro POS: usar otro puerto, ej. 3001)
# =========================
# PORT=3001

# =========================
# PostgreSQL (APP RUNTIME)
# =========================
# Use sys_app for the backend app connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Sys
DB_APP_USER=sys_app
DB_APP_PASSWORD=REEMPLAZAR_POR_CLAVE_ALEATORIA_SEGURA

# Optional single connection string (if you prefer this, it can replace DB_* above)
# DB_APP_URL=postgresql://sys_app:REEMPLAZAR_POR_CLAVE@localhost:5432/Sys

# Legacy compatibility aliases (optional)
# DB_USER=sys_app
# DB_PASSWORD=REEMPLAZAR_POR_CLAVE_ALEATORIA_SEGURA

# Public URL used by Menu Digital / QR.
# Example for LAN: http://192.168.0.3:3000
# Example with domain: https://menu.tunegocio.com
PUBLIC_BASE_URL=

# Optional SSL settings
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional pool tuning
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# =========================
# MAINTENANCE (REFERENCE)
# =========================
# Not used by runtime app. For DBA/admin tasks only.
DB_ADMIN_USER=sys_admin
DB_ADMIN_PASSWORD=Sys2026!IdentificadorCliente

# =========================
# OTHER KEYS
# =========================
# GEMINI_API_KEY=
