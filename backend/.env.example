# =========================================================
# ALPX Systems — Configuración de entorno
# Copiá este archivo como ".env" y ajustá los valores.
# Si no se define una variable, se usa el valor por defecto indicado.
# =========================================================

# --- Servidor HTTP ---
# Este proyecto (ALPX Systems / LibreríaSys) usa el puerto 3003.
# No usar 3001 (clínica) ni 3002 (Sys_ropa) en la misma PC.
PORT=3003

# --- Base de datos PostgreSQL ---
# Estas son las variables que usa la app (backend/db.js).
# En el PRIMER ARRANQUE, si la base no existe, la app la crea sola,
# carga el esquema y crea el usuario inicial (ADMIN / clave: admin).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_sys
DB_USER=postgres
DB_PASSWORD=12345

# --- Seguridad ---
# Clave para firmar las sesiones (JWT). Cambiala por una aleatoria en producción.
# JWT_SECRET=cambiar_por_clave_aleatoria_larga

# --- Licencia (control de suscripción) ---
# Clave secreta para validar/renovar la licencia de ESTE cliente.
# IMPORTANTE: poné un número distinto para CADA cliente y guardátelo en una
# lista privada (ej: "Cliente Juan = 11223344"). Con esa misma clave generás
# el código de renovación desde herramientas_vendedor/generar_licencia.js.
# Si un cliente filtra su clave, solo afecta su instalación, no las demás.
LICENSE_SECRET_NUM=73915482

# --- Menú Digital / QR (opcional) ---
# URL pública para acceder al catálogo desde celulares.
# Ej LAN: http://192.168.0.3:3001   Ej dominio: https://menu.tunegocio.com
PUBLIC_BASE_URL=

# --- API externa (opcional) ---
# GEMINI_API_KEY=
