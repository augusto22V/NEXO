{
  "name": "libreriasuys",
  "productName": "ALPX Systems",
  "version": "1.0.0",
  "description": "Sistema de gestión - ALPX Systems",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.alpx.libreriasuys",
    "productName": "ALPX Systems",
    "copyright": "ALPX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "frontend/**/*",
      "backend/**/*",
      "!backend/node_modules/.cache/**",
      "!**/node_modules/.bin/**",
      "!**/*.md",
      "!**/.git/**",
      "!backend/uploads/**",
      "!frontend/modulos/config/licencia_generador.html",
      "!herramientas_vendedor/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/recursos/img/alpx-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALPX Systems",
      "installerIcon": "frontend/recursos/img/alpx-logo.png",
      "uninstallerIcon": "frontend/recursos/img/alpx-logo.png"
    }
  }
}
